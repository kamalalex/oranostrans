<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect root to /fr/
  RewriteRule ^$ /fr/ [L,R=301]

  # Ensure DirectoryIndex is set
  DirectoryIndex index.html

  # Fix for Hostinger: If a directory is requested without a slash, redirect to the slash version
  # This prevents 403 on directories like /fr, /fr/about, etc.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # Standard 404 handling for static sites
  ErrorDocument 404 /404.html
</IfModule>
